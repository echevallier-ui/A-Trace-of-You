{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "bce4e01f2f8d435fa6f115aa796ff8c9",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GetLightingInfo (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -644.0,
            "y": 526.3999633789063,
            "width": 256.79998779296877,
            "height": 143.20001220703126
        }
    },
    "m_Slots": [
        {
            "m_Id": "fbc16f8a93194410815a2bdfeb4196de"
        },
        {
            "m_Id": "ef5d3b6c39c84069be03b4d14d2e7fe6"
        },
        {
            "m_Id": "004a5862dd714284ae3c1b9ea99726ed"
        },
        {
            "m_Id": "45e93aa9d27c48ab8fdd04904250e1cb"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GetLightingInfo",
    "m_FunctionSource": "0ca24663bcac80d46aa62faddb0ae18a",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(SHADERGRAPH_PREVIEW)\nLightIntensity = 1.0;\n#else\nfloat4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\nLight mainLight = GetMainLight(shadowCoord);\nfloat NdotL = saturate(dot(WorldNormal, mainLight.direction));\nLightIntensity = saturate(NdotL * mainLight.distanceAttenuation * mainLight.shadowAttenuation);\n#endif"
}

